{
  "name": "neurocode-ai",
  "displayName": "NeuroCode - In-Memory Context Slicer & Local SWE Agent",
  "description": "Zero-daemon AST reachability slicer & subtree grafting for local models (Ollama, Cursor, Claude). Fits repository context into sub-1,200 tokens for 4GB-8GB GPU bug repair.",
  "version": "1.4.0",
  "publisher": "DeepakR",
  "author": {
    "name": "Deepak R.",
    "url": "https://github.com/Arkz-Deepak"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Arkz-Deepak/neurocode"
  },
  "bugs": {
    "url": "https://github.com/Arkz-Deepak/neurocode/issues"
  },
  "homepage": "https://github.com/Arkz-Deepak/neurocode#readme",
  "license": "MIT",
  "icon": "icon.png",
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "context-slicer",
    "ast",
    "code-graph",
    "ollama",
    "local-llm",
    "swe-bench",
    "cpg"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "neurocode.sliceActiveFile",
        "title": "NeuroCode: Slice Context for Active File",
        "category": "NeuroCode",
        "icon": "$(graph)"
      },
      {
        "command": "neurocode.copySlicedContext",
        "title": "NeuroCode: Copy Sliced Sub-1,200 Token Context to Clipboard",
        "category": "NeuroCode",
        "icon": "$(clippy)"
      },
      {
        "command": "neurocode.hardwareHealth",
        "title": "NeuroCode: Check Hardware Health & VRAM",
        "category": "NeuroCode",
        "icon": "$(dashboard)"
      },
      {
        "command": "neurocode.repairIssue",
        "title": "NeuroCode: Autonomous Repair with Local Ollama",
        "category": "NeuroCode",
        "icon": "$(tools)"
      },
      {
        "command": "neurocode.configureMCP",
        "title": "NeuroCode: Auto-Configure Claude Desktop & Cursor MCP",
        "category": "NeuroCode",
        "icon": "$(plug)"
      },
      {
        "command": "neurocode.launchProxy",
        "title": "NeuroCode: Launch Transparent AI Proxy Gateway",
        "category": "NeuroCode",
        "icon": "$(server)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "neurocode.sliceActiveFile",
          "group": "neurocode@1"
        },
        {
          "command": "neurocode.copySlicedContext",
          "group": "neurocode@2"
        }
      ],
      "commandPalette": [
        { "command": "neurocode.sliceActiveFile" },
        { "command": "neurocode.copySlicedContext" },
        { "command": "neurocode.hardwareHealth" },
        { "command": "neurocode.repairIssue" },
        { "command": "neurocode.configureMCP" },
        { "command": "neurocode.launchProxy" }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "neurocode-sidebar",
          "title": "NeuroCode",
          "icon": "$(circuit-board)"
        }
      ]
    },
    "views": {
      "neurocode-sidebar": [
        {
          "type": "webview",
          "id": "neurocode.controlCenter",
          "name": "Control Center"
        }
      ]
    },
    "configuration": {
      "title": "NeuroCode",
      "properties": {
        "neurocode.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Path to Python executable with neurocode-ai installed."
        },
        "neurocode.tokenBudget": {
          "type": "number",
          "default": 1200,
          "description": "Maximum token budget for AST reachability context closures."
        },
        "neurocode.ollamaModel": {
          "type": "string",
          "default": "qwen2.5-coder:1.5b",
          "description": "Default local Ollama model backbone for edge bug repair."
        },
        "neurocode.ollamaHost": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Ollama server API host URL."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --watch",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.9.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.4.0"
  }
}
